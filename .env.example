# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=document_qa
DB_USER=document_qa_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5433

# Docker PostgreSQL port exposed on the host
POSTGRES_HOST_PORT=5433

# Embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# OpenRouter
OPENROUTER_API_KEY=change-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_APP_URL=http://localhost:8000
OPENROUTER_APP_NAME=Document QA RAG
OPENROUTER_TEMPERATURE=0
OPENROUTER_MAX_TOKENS=512
OPENROUTER_TIMEOUT_MS=120000
OPENROUTER_MAX_RETRIES=1