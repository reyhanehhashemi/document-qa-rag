# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=document_qa
DB_USER=document_qa_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
